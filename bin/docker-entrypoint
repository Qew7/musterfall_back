#!/bin/bash -e

# Dev compose mounts the host tree: compile here so a Mac .bundle is not used on Linux.
# Production image already has the kernel from `docker build` and has no compiler.
if command -v make >/dev/null && [ -f ext/sim_obb/extconf.rb ]; then
  (cd ext/sim_obb && ruby extconf.rb >/dev/null && make -s clean && make -s) || true
fi

# If running the rails server then create or migrate existing database
if [ "$1" == "./bin/rails" ] && [ "$2" == "server" ]; then
  rm -f tmp/pids/server.pid
  ./bin/rails db:prepare
  ./bin/rails db:load_queue_schema
fi

if [ "$1" == "bin/jobs" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:load_queue_schema
fi

exec "${@}"
